<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Botón de regreso -->
    <Button
        android:id="@+id/backButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="?attr/colorPrimary"
        android:padding="8dp"
        android:text="Regresar"
        android:textColor="@android:color/white" />

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/tituloActividades"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Actividades del Itinerario"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_gravity="center_horizontal"
        android:paddingBottom="16dp" />

    <!-- Contenedor para el nombre del itinerario y el botón -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <!-- Campo editable para el nombre del itinerario -->
        <EditText
            android:id="@+id/nombreItinerarioEditText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:hint="Nombre del Itinerario"
            android:textSize="16sp" />

        <!-- Botón para cambiar el nombre -->
        <Button
            android:id="@+id/cambiarNombreButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cambiar Nombre"
            android:backgroundTint="?attr/colorPrimary"
            android:textColor="@android:color/white"
            android:padding="8dp" />
    </LinearLayout>

    <!-- Botón para agregar actividades -->
    <Button
        android:id="@+id/agregarActividadesButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="?attr/colorPrimary"
        android:padding="8dp"
        android:text="Agregar Actividades"
        android:textColor="@android:color/white" />

    <!-- Botón para eliminar el itinerario -->
    <Button
        android:id="@+id/deleteButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:backgroundTint="@android:color/holo_red_dark"
        android:padding="8dp"
        android:text="Eliminar Itinerario"
        android:textColor="@android:color/white" />

    <!-- RecyclerView para mostrar actividades -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewActividades"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

    <!-- Bottom Navigation -->
    <include layout="@layout/bottom_navigation" />
</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white"
    android:padding="16dp"
    android:layout_gravity="end"
    android:clickable="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:elevation="4dp"
    android:backgroundTint="@android:color/white">

    <TextView
        android:id="@+id/menuPerfil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawableStart="@drawable/ic_profile"
        android:drawablePadding="16dp"
        android:padding="12dp"
        android:text="Perfil"
        android:textSize="18sp"
        android:textColor="@android:color/black"/>
</androidx.cardview.widget.CardView>

<androidx.cardview.widget.CardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="8dp"
android:elevation="4dp"
android:backgroundTint="@android:color/white">

<TextView
    android:id="@+id/menuHistorial"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:drawableStart="@drawable/ic_history"
    android:drawablePadding="16dp"
    android:padding="16dp"
    android:text="Historial"
    android:textSize="18sp"
    android:textColor="@android:color/black"/>
</androidx.cardview.widget.CardView>

<androidx.cardview.widget.CardView
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:layout_marginBottom="24dp"
android:elevation="4dp"
android:backgroundTint="@android:color/white">

<TextView
    android:id="@+id/menuConfiguracion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:drawableStart="@drawable/ic_settings"
    android:drawablePadding="16dp"
    android:padding="16dp"
    android:text="Configuración"
    android:textSize="18sp"
    android:textColor="@android:color/black"/>
</androidx.cardview.widget.CardView>

<TextView
android:id="@+id/menuTerminos"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:drawableStart="@drawable/ic_terms"
android:drawablePadding="16dp"
android:padding="8dp"
android:text="Términos y condiciones"
android:textSize="16sp"
android:textColor="@android:color/black"/>

<TextView
android:id="@+id/menuPrivacidad"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:drawableStart="@drawable/ic_privacy"
android:drawablePadding="16dp"
android:padding="8dp"
android:text="Política de privacidad"
android:textSize="16sp"
android:textColor="@android:color/black"/>

<TextView
android:id="@+id/menuCerrarSesion"
android:layout_width="match_parent"
android:layout_height="wrap_content"
android:drawableStart="@drawable/ic_logout"
android:drawablePadding="16dp"
android:padding="8dp"
android:text="Cerrar sesión"
android:textSize="16sp"
android:textColor="@android:color/black"/>

<LinearLayout
android:layout_width="match_parent"
android:layout_height="0dp"
android:layout_weight="1" />

</LinearLayout>